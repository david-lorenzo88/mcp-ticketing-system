# ---------------------------------------------------------------------------
# Baltic Summit Ticketing — environment configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local (docker compose): the value below matches docker-compose.yml.
# Azure Database for PostgreSQL Flexible Server requires sslmode=require, e.g.
#   postgresql://USER:PASSWORD@my-pg.postgres.database.azure.com:5432/baltic_tickets?sslmode=require
DATABASE_URL="postgresql://baltic:baltic@localhost:5432/baltic_tickets?schema=public"

# HTTP port the server listens on. Azure Container Apps injects this.
PORT=8080

# "development" | "production" | "test"
NODE_ENV=development

# Prefix used to render human-readable ticket numbers, e.g. BS26-00042.
TICKET_PREFIX=BS26

# Timezone the conference agenda is published in. Session start/end times are
# shown and filtered in this zone.
EVENT_TIMEZONE=Europe/Warsaw

# Comma-separated list of allowed browser origins for the REST API.
# Use "*" to allow any origin (fine while the app is public and unauthenticated).
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Optional shared-secret for the /mcp endpoint ONLY. It does not protect
# /api/tickets or the web UI — the browser app cannot hold a secret. See the
# "Two things to know" section of README.md before relying on it.
# Leave EMPTY to keep the MCP server fully open (no authentication) — this is
# the default and matches a "no auth" setup.
# If you set it, agents must send it as either:
#   Authorization: Bearer <value>     or     x-api-key: <value>
# Both Copilot Studio custom connectors and Azure AI Foundry can send these.
# ---------------------------------------------------------------------------
MCP_API_KEY=

# Public base URL of the deployed service. Only used to print the MCP URL in
# logs and in the /healthz payload; safe to leave empty.
PUBLIC_BASE_URL=
