// Baltic Summit — ticketing & admission data model.
//
// Regenerate the client after changing this file:  npm run db:generate
// Create a migration during development:           npm run db:migrate
// Apply migrations in Azure:                       npm run db:deploy

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

// Prisma 7 keeps connection URLs out of the schema: the migration/introspection
// URL lives in `prisma.config.ts`, and the runtime client is given a driver
// adapter (see src/index.ts).
datasource db {
  provider = "postgresql"
}

/// What the holder is entitled to attend.
enum TicketType {
  FULL_PASS // Workshop day + both conference days
  CONFERENCE // Conference days only
  WORKSHOP // Workshop day only
  SPEAKER
  SPONSOR
  VOLUNTEER
  STUDENT
}

/// Lifecycle of a ticket, from reservation through admission.
enum TicketStatus {
  RESERVED // Held, not yet paid/confirmed
  CONFIRMED // Valid for admission
  CHECKED_IN // Admitted at the door
  CANCELLED // Void, not valid for admission
}

model Ticket {
  id String @id @default(uuid())

  /// Monotonic counter rendered as the public ticket number, e.g. BS26-00042.
  /// The prefix lives in the TICKET_PREFIX env var, not in the database.
  reference Int @unique @default(autoincrement())

  // --- Attendee ---------------------------------------------------------
  firstName String @db.VarChar(100)
  lastName  String @db.VarChar(100)
  email     String @db.VarChar(255)
  phone     String? @db.VarChar(50)
  company   String? @db.VarChar(150)
  jobTitle  String? @db.VarChar(150)

  // --- Entitlement ------------------------------------------------------
  ticketType TicketType   @default(CONFERENCE)
  status     TicketStatus @default(RESERVED)

  priceAmount Decimal @default(0) @db.Decimal(10, 2)
  currency    String  @default("PLN") @db.VarChar(3)

  dietaryRequirements String? @db.VarChar(500)
  notes               String? @db.VarChar(2000)

  // --- Lifecycle timestamps --------------------------------------------
  checkedInAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?   @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ticketType])
  @@index([email])
  @@index([createdAt])
  @@map("tickets")
}

// ===========================================================================
// Conference programme — https://balticsummit.pl/sessions2026
//
// Loaded from packages/database/data/sessions2026.json by
// `npm run db:import-sessions`. The import upserts on `externalId`, so it can
// be re-run whenever the published agenda changes.
// ===========================================================================

/// What kind of slot a session is. OTHER covers anything the agenda labels
/// differently; the original label is kept in `Session.formatLabel`.
enum SessionFormat {
  KEYNOTE
  TALK
  WORKSHOP
  PANEL
  LIGHTNING
  BREAK // Coffee, lunch, registration, networking
  OTHER
}

model Session {
  id String @id @default(uuid())

  /// Stable id from the source agenda (e.g. its slug or Sessionize id).
  /// Imports match on this, so re-importing updates rather than duplicates.
  externalId String @unique @db.VarChar(100)

  title       String  @db.VarChar(300)
  description String? @db.Text

  // --- Schedule ---------------------------------------------------------
  /// Calendar day of the event (Europe/Warsaw), used for per-day filtering.
  /// Null for a session that is published but not yet given a slot.
  day      DateTime? @db.Date
  startsAt DateTime? @db.Timestamptz(6)
  endsAt   DateTime? @db.Timestamptz(6)
  room     String?   @db.VarChar(100)

  // --- Classification ---------------------------------------------------
  format      SessionFormat @default(TALK)
  formatLabel String?       @db.VarChar(100)
  track       String?       @db.VarChar(100)
  level       String?       @db.VarChar(50) /// e.g. Beginner, Intermediate, Advanced, or 100–400
  language    String?       @db.VarChar(50)
  tags        String[]      @default([])

  url        String? @db.VarChar(500) /// Session detail page, when the agenda has one
  partnerUrl String? @db.VarChar(500) /// Sponsor/partner website for partner-delivered sessions

  speakers SessionSpeaker[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([day, startsAt])
  @@index([room])
  @@index([track])
  @@index([format])
  @@map("sessions")
}

model Speaker {
  id String @id @default(uuid())

  /// Stable id from the source agenda; falls back to a slug of the name.
  externalId String @unique @db.VarChar(100)

  fullName String  @db.VarChar(150)
  company  String? @db.VarChar(150)
  jobTitle String? @db.VarChar(150)
  /// Profile headline as published, e.g. "Microsoft MVP | Power Platform Architect".
  tagline  String? @db.Text
  /// Recognitions shown on the profile, e.g. MVP, MCT.
  badges   String[] @default([])
  bio      String? @db.Text
  photoUrl String? @db.VarChar(500)
  /// Profile links keyed by kind, e.g. { "linkedin": "...", "twitter": "..." }.
  links    Json?

  sessions SessionSpeaker[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@map("speakers")
}

/// Sessions can have several speakers and speakers can give several sessions.
model SessionSpeaker {
  sessionId String
  speakerId String
  /// Order the speakers are listed in on the agenda.
  position  Int    @default(0)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@id([sessionId, speakerId])
  @@index([speakerId])
  @@map("session_speakers")
}
